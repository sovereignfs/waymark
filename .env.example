# Every setting Waymark reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Waymark gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
WAYMARK_URL=http://localhost:3005

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Import, mail, reminders and clean-up run inside the web process. When several processes share one database, set `off` on all but one.
# WAYMARK_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and an authenticator app.
WAYMARK_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
WAYMARK_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
WAYMARK_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# WAYMARK_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). WAYMARK_CORE_URL is the instance's core, its OIDC
# issuer: its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <WAYMARK_URL>/api/auth/callback/sovereign. Needs WAYMARK_URL and WAYMARK_AUTH_SECRET as local sign-in does; WAYMARK_AUTH_LOCAL may then be 0.
# WAYMARK_CORE_URL=https://sovereign.example.com
# WAYMARK_CORE_CLIENT_ID=
# WAYMARK_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# WAYMARK_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# WAYMARK_SQLD_URL=http://sqld:8080
# WAYMARK_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# WAYMARK_SQLITE_URL=file:/data/waymark.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# WAYMARK_POSTGRES_URL=postgres://user:password@localhost:5432/waymark
# PGSSLROOTCERT=
# WAYMARK_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# WAYMARK_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# WAYMARK_MIGRATIONS_DIR=

# --- Encryption at rest ----------------------------------------------------------------------------------------------------------------
# Required. Everything that says where or what (places, notes, titles, names, files) is sealed under this key before it is stored. Make it once and
# keep it with your secrets, apart from the database backups: a lost key means the data cannot be read.   openssl rand -base64 32
WAYMARK_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has moved the data to the new one.
# WAYMARK_ENCRYPTION_KEY_PREVIOUS=

# --- Finding a place ----------------------------------------------------------------------------------------------------------------
# `nominatim` (the default), `photon` or `off`. What a person types in the place search is sent to this provider, from the server and never from the browser;
# `off` sends nothing, and a place can still be added by hand. With no address, the public instance of the provider is used, and its usage policy is kept:
# one request a second from the whole server, results kept a day, a User-Agent naming Waymark and WAYMARK_URL. An address of your own lifts all of that.
# WAYMARK_PLACES_PROVIDER=nominatim
# WAYMARK_PLACES_URL=https://nominatim.example.com
# To try the search with no network: `pnpm places:fake`, then WAYMARK_PLACES_URL=http://127.0.0.1:3990 (search for tokyo, cafe, lisbon, central).

# --- The map ----------------------------------------------------------------------------------------------------------------------------
# `proxy` (the default), `pmtiles` or `off`. The browser only ever asks Waymark for tiles; this says where Waymark gets them. `off` has no map, and every map view shows its list.
# WAYMARK_MAP_SOURCE=proxy
# proxy: a TileJSON, or a tile address with {z}, {x} and {y}. Default OpenFreeMap's planet: free, no key, and its terms do not say whether a server may keep tiles for its users
# (README, "The map"): for anything that matters, use pmtiles or a tile server of your own.
# WAYMARK_MAP_UPSTREAM_URL=https://tiles.openfreemap.org/planet
# The most the cache of fetched tiles may hold, in megabytes. Default 2048.
# WAYMARK_MAP_CACHE_MAX_MB=2048
# pmtiles: the file to read tiles from, in the OpenMapTiles schema (planetiler makes one), by absolute path; put it under the data directory's map/ folder.
# WAYMARK_MAP_PMTILES_PATH=/data/map/region.pmtiles

# --- Files ----------------------------------------------------------------------------------------------------------------------------
# Everything the app writes beside the database (photos, files, imports, the map's cache) is under this directory, which the image makes and its manifest
# declares. Default /data. Photos and files are sealed on disk under WAYMARK_ENCRYPTION_KEY.
# WAYMARK_DATA_DIR=/data
# The most one account may keep in files, in megabytes. Default 500.
# WAYMARK_MEDIA_MAX_ACCOUNT_MB=500

# --- Mail (optional) ----------------------------------------------------------------------------------------------------------------------
# With no host there is no mail: addresses are not verified, passwords are not reset by mail, and invitations are links to hand over.
# WAYMARK_SMTP_HOST=smtp.example.com
# 587 by default; 465 is SMTPS.
# WAYMARK_SMTP_PORT=587
# WAYMARK_SMTP_FROM=Waymark <waymark@example.com>
# WAYMARK_SMTP_USER=
# WAYMARK_SMTP_PASSWORD=
