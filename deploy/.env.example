# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Waymark reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
WAYMARK_URL=http://localhost:3005
# The port on this machine that a reverse proxy sends to (the container listens on 3005, the port in sovereign.manifest.json).
# WAYMARK_PORT=3005

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
WAYMARK_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
WAYMARK_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. `invite`: the first account, and anyone holding a valid invitation to a trip. Unset, it is `invite`, or `open` when a Sovereign core is the only way in.
WAYMARK_AUTH_SIGNUP=invite

# --- Encryption at rest -------------------------------------------------------------------------------------------
# Required. Everything that says where or what is sealed under this key before it is stored. Make it once and keep it with your secrets, apart from the
# database backups: a lost key means the data cannot be read.   openssl rand -base64 32
WAYMARK_ENCRYPTION_KEY=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
