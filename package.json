{
  "name": "@sovereignfs/waymark",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/waymark.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "description": "Waymark: check in where you are, plan trips with the people going, and look back on everywhere you have been.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "PORT=${PORT:-3005} node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "places:fake": "node scripts/fake-places.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "e2e": "playwright test",
    "e2e:fast": "node scripts/e2e-shard.mjs --all",
    "manifest:check": "sovereign-manifest check",
    "test:zones": "TZ=UTC vitest run src/places/tz.test.ts src/figures && TZ=Pacific/Auckland vitest run src/places/tz.test.ts src/figures && TZ=America/Los_Angeles vitest run src/places/tz.test.ts src/figures"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.7.16",
    "@better-auth/passkey": "1.7.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/sdk": "2.1.0",
    "@sovereignfs/ui": "0.92.0",
    "better-auth": "~1.7.16",
    "drizzle-orm": "^0.45.4",
    "idb": "^8.0.4",
    "next": "^16.4.6",
    "nodemailer": "10.4.0",
    "pg": "^8.23.1",
    "pmtiles": "^4.5.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tz-lookup": "6.1.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.6.0",
    "@playwright/test": "1.65.0",
    "@sovereignfs/manifest": "^0.1.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.8",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jose": "6.2.17",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
